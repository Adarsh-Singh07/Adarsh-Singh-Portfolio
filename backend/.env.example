# ===== Existing portfolio configuration =====
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# SMTP (legacy Zoho/Resend fallback — kept until Lark is live-verified)
SMTP_HOST="smtp.zoho.in"
SMTP_PORT="465"
SMTP_USER="contact@adarshsingh.in"
SMTP_PASSWORD="your_smtp_password"
SMTP_TO="contact@adarshsingh.in"
RESEND_API_KEY=""
RESEND_FROM="contact@adarshsingh.in"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_strong_admin_password_here"
ADMIN_SECRET_KEY="a_long_random_secret_string_for_signing_session_tokens"

# ===== Hermes social worker =====
HERMES_WORKER_SECRET=""

# ===== Email provider selection =====
# Switch between legacy "zoho" and new "lark" provider.
# Keep as "zoho" until Lark send/receive is verified with real credentials.
EMAIL_PROVIDER="zoho"

# ===== Lark Open Platform (Mail API) =====
# Create a custom app at https://open.larksuite.com/app
# App ID and App Secret from: App -> Credentials & Basic Info
LARK_APP_ID=""
LARK_APP_SECRET=""

# OAuth redirect URI registered in the Lark app (Features -> Redirect URLs).
# Must be an HTTPS endpoint you control.
LARK_REDIRECT_URI=""

# User access token + refresh token obtained via OAuth authorization_code flow.
# Populated by scripts/lark_oauth.py after you complete the consent screen.
# NEVER commit these. Store in deployment secret manager / .env only.
LARK_USER_ACCESS_TOKEN=""
LARK_REFRESH_TOKEN=""

# Webhook verification token (App -> Event Subscriptions -> Verification Token)
LARK_VERIFICATION_TOKEN=""
# Webhook encrypt key (App -> Event Subscriptions -> Encrypt Key)
LARK_ENCRYPT_KEY=""

# ===== Inbound processing =====
# Prefer event-driven webhooks. Enable polling only as a fallback.
EMAIL_POLL_ENABLED="false"
EMAIL_POLL_INTERVAL_SECONDS="60"

# ===== Automated replies =====
# Keep disabled until live Lark testing is complete.
AUTO_REPLY_ENABLED="false"

# ===== Lark scopes required in app permissions =====
# mail:user_mailbox.message:readonly  (list/get/mark/move/attachments)
# mail:user_mailbox.message:send      (send/reply, requires user_access_token)
# mail:user_mailbox.event:subscribe   (inbound mail events)
